<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool, not part of the mod: parses blazons and renders test PNGs outside the game.
       Builds against the same Heraldry/*.cs files the mod uses. Needs the .NET 8 SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ValheimHeraldryMod/Heraldry/*.cs" />
  </ItemGroup>
</Project>
